<Window Style="{StaticResource BaseWindow}" x:Class="BlackSite.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" Background="#F0060C18" MaxWidth="520" MinWidth="420"
        AllowsTransparency="False" KeyDown="Window_KeyDown">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="26,22,26,20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="Drag">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="26" Margin="0,0,14,0"/>
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Dim}" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,22"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- Cancel is the default and focused button; Confirm is never triggered by Enter. -->
                <Button x:Name="CancelButton" Content="CANCEL" Style="{StaticResource HudButton}" IsCancel="True" IsDefault="True" Width="120" Click="Cancel_Click"/>
                <Button x:Name="ConfirmButton" Content="CONFIRM" Style="{StaticResource DangerButton}" Width="120" Margin="0" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
