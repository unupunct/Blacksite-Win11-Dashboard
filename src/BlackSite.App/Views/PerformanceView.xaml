<UserControl x:Class="BlackSite.App.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BlackSite.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/><ColumnDefinition Width="2*" MinWidth="320"/>
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <HeaderedContentControl Style="{StaticResource HudPanel}" Header="CPU — LAST 90 SECONDS" Margin="0,0,0,10">
                <Grid>
                    <c:SparklineGraph x:Name="CpuGraph" Maximum="100"/>
                    <TextBlock x:Name="CpuText" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,6,0"/>
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Row="1" Style="{StaticResource HudPanel}" Header="MEMORY — LAST 90 SECONDS" Margin="0,0,0,10">
                <Grid>
                    <c:SparklineGraph x:Name="MemGraph" Maximum="100"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,6,0">
                        <TextBlock x:Name="MemText" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="MemDetail" Style="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Row="2" Style="{StaticResource HudPanel}" Header="NETWORK — DOWNLOAD / UPLOAD (Mbps)">
                <Grid>
                    <c:SparklineGraph x:Name="NetGraph" Maximum="0"/>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,6,0">
                        <TextBlock x:Name="NetDown" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="NetUp" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </HeaderedContentControl>
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <HeaderedContentControl Style="{StaticResource HudPanel}" Header="SYSTEM" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PROCESSOR" Style="{StaticResource Dim}" FontSize="11" Margin="0,3,16,3"/>
                    <TextBlock x:Name="CpuName" Grid.Column="1" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                    <TextBlock Grid.Row="1" Text="LOGICAL CORES" Style="{StaticResource Dim}" FontSize="11" Margin="0,3,16,3"/>
                    <TextBlock x:Name="Cores" Grid.Row="1" Grid.Column="1" FontSize="13" Margin="0,3"/>
                    <TextBlock Grid.Row="2" Text="UPTIME" Style="{StaticResource Dim}" FontSize="11" Margin="0,3,16,3"/>
                    <TextBlock x:Name="Uptime" Grid.Row="2" Grid.Column="1" FontSize="13" Margin="0,3"/>
                    <TextBlock Grid.Row="3" Text="PROCESSES" Style="{StaticResource Dim}" FontSize="11" Margin="0,3,16,3"/>
                    <TextBlock x:Name="ProcCount" Grid.Row="3" Grid.Column="1" FontSize="13" Margin="0,3"/>
                    <TextBlock Grid.Row="4" Text="NETWORK" Style="{StaticResource Dim}" FontSize="11" Margin="0,3,16,3"/>
                    <TextBlock x:Name="NetAdapter" Grid.Row="4" Grid.Column="1" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                </Grid>
            </HeaderedContentControl>
            <HeaderedContentControl Grid.Row="1" Style="{StaticResource HudPanel}" Header="TOP PROCESSES BY MEMORY">
                <ItemsControl x:Name="TopList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource Dim}" FontSize="12"/>
                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Height="3" Maximum="1" Value="{Binding Fraction}" Margin="0,3,0,0"
                                             Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource AccentBrushFaint}" BorderThickness="0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>
        </Grid>
    </Grid>
</UserControl>
