<Window Style="{StaticResource BaseWindow}" x:Class="BlackSite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:BlackSite.App.Controls"
        Title="BLACKSITE — SYSTEM CONTROL PANEL" Width="1440" Height="860" MinWidth="960" MinHeight="600"
        Background="#040810" WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <c:BackgroundCanvas x:Name="Bg"/>
        <c:ParticleLayer x:Name="Particles"/>

        <Grid x:Name="Shell" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid x:Name="HeaderBar" MouseLeftButtonDown="Header_MouseDown">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrushDim}" BorderThickness="1" CornerRadius="3"/>
                <Rectangle Height="2" VerticalAlignment="Bottom" Fill="{DynamicResource AccentBrush}" Opacity="0.7" Margin="1,0"/>
                <Grid Margin="18,8,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Grid Width="46" Height="46" Margin="0,0,14,0">
                            <Path Data="M23,2 L42,13 L42,33 L23,44 L4,33 L4,13 Z" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                  Fill="{DynamicResource AccentBrushFaint}">
                                <Path.Effect><DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
                            </Path>
                            <Path Data="M23,14 L32,19 L32,29 L23,34 L14,29 L14,19 Z" Fill="{DynamicResource AccentBrush}" Opacity="0.85"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="B&#x2009;L&#x2009;A&#x2009;C&#x2009;K&#x2009;S&#x2009;I&#x2009;T&#x2009;E" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="S&#x2009;Y&#x2009;S&#x2009;T&#x2009;E&#x2009;M&#x2002;C&#x2009;O&#x2009;N&#x2009;T&#x2009;R&#x2009;O&#x2009;L&#x2002;P&#x2009;A&#x2009;N&#x2009;E&#x2009;L" FontSize="11"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <StackPanel Margin="0,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="OsText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="BuildText" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock x:Name="ClockH" FontFamily="{StaticResource MonoFont}" FontSize="32" FontWeight="Bold"/>
                                <TextBlock x:Name="Colon1" Text=":" FontFamily="{StaticResource MonoFont}" FontSize="32" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="ClockM" FontFamily="{StaticResource MonoFont}" FontSize="32" FontWeight="Bold"/>
                                <TextBlock x:Name="Colon2" Text=":" FontFamily="{StaticResource MonoFont}" FontSize="32" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock x:Name="ClockS" FontFamily="{StaticResource MonoFont}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="DateText" Style="{StaticResource Dim}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                            <Ellipse x:Name="OnlineDot" Width="10" Height="10" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Effect><DropShadowEffect Color="{StaticResource GreenColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="SYSTEM ONLINE" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                            <StackPanel x:Name="Bars" Orientation="Horizontal" Margin="14,0,0,0" Height="18" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="FullBtn" Style="{StaticResource WindowButton}" Content="&#xE740;" ToolTip="Fullscreen (F11)" AutomationProperties.Name="Fullscreen" Click="Full_Click"/>
                        <StackPanel x:Name="CaptionButtons" Orientation="Horizontal">
                            <Button Style="{StaticResource WindowButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Min_Click"/>
                            <Button x:Name="MaxBtn" Style="{StaticResource WindowButton}" Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Max_Click"/>
                            <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- PAGE HOST -->
            <ContentControl x:Name="Host" Grid.Row="1" IsTabStop="False"/>

            <!-- NAVIGATION -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrushDim}" BorderThickness="1" CornerRadius="3"/>
                <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource AccentBrush}" Opacity="0.7" Margin="1,0"/>
                <UniformGrid x:Name="NavGrid" Rows="1" Margin="10,4" HorizontalAlignment="Center" MinWidth="780">
                    <RadioButton Style="{StaticResource NavButton}" Uid="dashboard" Content="DASHBOARD" Tag="&#xE80F;" GroupName="nav" Checked="Nav_Checked" IsChecked="True"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="computer" Content="COMPUTER" Tag="&#xE7F4;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="network" Content="NETWORK" Tag="&#xE968;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="security" Content="SECURITY" Tag="&#xEA18;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="performance" Content="PERFORMANCE" Tag="&#xE9D9;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="files" Content="FILES" Tag="&#xE8B7;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="settings" Content="SETTINGS" Tag="&#xE713;" GroupName="nav" Checked="Nav_Checked"/>
                    <RadioButton Style="{StaticResource NavButton}" Uid="info" Content="INFORMATION" Tag="&#xE946;" GroupName="nav" Checked="Nav_Checked"/>
                </UniformGrid>
            </Grid>

            <!-- TOAST -->
            <Border x:Name="Toast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="18,9"
                    CornerRadius="3" BorderThickness="1" Background="#F00B1B30" BorderBrush="{DynamicResource AccentBrush}" Visibility="Collapsed"
                    IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="14"/>
            </Border>
        </Grid>

        <!-- Scan line overlay -->
        <Rectangle x:Name="ScanLine" Height="140" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop x:Name="ScanStop" Color="#2800E5FF" Offset="0.85"/>
                    <GradientStop Color="#6000E5FF" Offset="0.97"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform><TranslateTransform x:Name="ScanShift" Y="-150"/></Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</Window>
