<UserControl x:Class="BlackSite.App.Views.FutureModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <HeaderedContentControl Style="{StaticResource HudPanel}" Margin="0,10,0,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="72" Opacity="0.6"/>
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
            <Border BorderBrush="{StaticResource OrangeBrush}" BorderThickness="1" CornerRadius="3" Padding="12,3" HorizontalAlignment="Center">
                <TextBlock Text="FUTURE MODULE — NOT YET AVAILABLE" FontSize="12" Foreground="{StaticResource OrangeBrush}"/>
            </Border>
            <TextBlock x:Name="BodyText" Style="{StaticResource Dim}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </HeaderedContentControl>
</UserControl>
