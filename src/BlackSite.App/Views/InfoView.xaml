<UserControl x:Class="BlackSite.App.Views.InfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" Padding="0,0,10,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <HeaderedContentControl Style="{StaticResource HudPanel}" Header="THIS COMPUTER" Margin="0,0,10,0" VerticalAlignment="Top">
                <ItemsControl x:Name="Facts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </HeaderedContentControl>
            <StackPanel Grid.Column="1">
                <HeaderedContentControl Style="{StaticResource HudPanel}" Header="BLACKSITE" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="A Windows 11 shortcut launcher and live system monitor. All readings come from real Windows counters; nothing is simulated."
                                   Style="{StaticResource Dim}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="OPEN DATA FOLDER" Style="{StaticResource HudButton}" Click="OpenData_Click"/>
                            <Button Content="OPEN LOG FILE" Style="{StaticResource HudButton}" Click="OpenLog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>
                <HeaderedContentControl Style="{StaticResource HudPanel}" Header="KEYBOARD">
                    <ItemsControl x:Name="Keys">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border BorderBrush="{DynamicResource AccentBrushDim}" BorderThickness="1" CornerRadius="3" Padding="8,1" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Key}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </HeaderedContentControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
