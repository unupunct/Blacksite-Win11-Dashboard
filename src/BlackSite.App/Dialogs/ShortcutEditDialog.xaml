<Window Style="{StaticResource BaseWindow}" x:Class="BlackSite.App.Dialogs.ShortcutEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" Background="#F0060C18">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24,18,24,18">
        <StackPanel>
            <TextBlock x:Name="HeadText" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" MouseLeftButtonDown="Drag"/>
            <TextBlock Text="NAME" Style="{StaticResource Dim}" FontSize="11" Margin="0,16,0,4"/>
            <TextBox x:Name="NameBox" MaxLength="32"/>
            <TextBlock Text="DESCRIPTION" Style="{StaticResource Dim}" FontSize="11" Margin="0,12,0,4"/>
            <TextBox x:Name="DescBox" MaxLength="40"/>
            <TextBlock Text="TARGET  (program file, or an ms-settings: / https:// / shell:AppsFolder link)" Style="{StaticResource Dim}" FontSize="11" Margin="0,12,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox"/>
                <Button Grid.Column="1" Content="BROWSE…" Style="{StaticResource HudButton}" Margin="8,0,0,0" Click="BrowseTarget_Click"/>
            </Grid>
            <TextBlock Text="ICON  (optional image or program; blank = automatic)" Style="{StaticResource Dim}" FontSize="11" Margin="0,12,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="IconBox"/>
                <Button Grid.Column="1" Content="BROWSE…" Style="{StaticResource HudButton}" Margin="8,0,0,0" Click="BrowseIcon_Click"/>
            </Grid>
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="CANCEL" Style="{StaticResource HudButton}" IsCancel="True" Width="110"/>
                <Button Content="SAVE" Style="{StaticResource HudButton}" IsDefault="True" Width="110" Margin="0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
