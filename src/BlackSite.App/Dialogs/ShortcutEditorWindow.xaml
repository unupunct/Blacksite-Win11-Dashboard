<Window Style="{StaticResource BaseWindow}" x:Class="BlackSite.App.Dialogs.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Width="640" Height="620"
        WindowStartupLocation="CenterOwner" Background="#F0060C18">
    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Padding="24,18,24,18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel MouseLeftButtonDown="Drag">
                <TextBlock Text="SHORTCUT EDITOR" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="Drag items to reorder. Targets are validated before saving; custom shortcuts can never pass command-line arguments."
                           Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>
            </StackPanel>
            <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0" AllowDrop="True"
                     PreviewMouseLeftButtonDown="List_PreviewMouseDown" PreviewMouseMove="List_PreviewMouseMove"
                     Drop="List_Drop" DragOver="List_DragOver" MouseDoubleClick="Edit_Click"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20"/>
                            <StackPanel Grid.Column="1" Margin="8,0">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Target}" Style="{StaticResource Dim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{Binding StatusBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="ADD" Style="{StaticResource HudButton}" Click="Add_Click"/>
                <Button x:Name="EditBtn" Content="EDIT / REPLACE" Style="{StaticResource HudButton}" Click="Edit_Click"/>
                <Button x:Name="RemoveBtn" Content="REMOVE" Style="{StaticResource DangerButton}" Click="Remove_Click"/>
                <Button Content="RESTORE DEFAULTS" Style="{StaticResource HudButton}" Click="Restore_Click"/>
                <Button Content="CLOSE" Style="{StaticResource HudButton}" IsCancel="True" IsDefault="True" Margin="24,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
